#!/usr/bin/env python3
"""planner: check and render an initiative vault. The format is in CONVENTIONS.md."""
import pathlib
import sys

# 3.9 is what a Mac's /usr/bin/python3 ships, so a colleague needs nothing installed to run planner.
if sys.version_info < (3, 9):
    print("planner: needs Python 3.9 or later. On a Mac: brew install python@3.12", file=sys.stderr)
    sys.exit(2)

# A vault is a git repo. Compiled caches written next to a copied plugin would end up committed.
sys.dont_write_bytecode = True

# lib/ goes first on the path, so `import yaml` is always the vendored PyYAML in lib/yaml, never a copy
# installed on this machine: the same YAML behavior everywhere, and no pip step for whoever installs the plugin.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

from planner.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
