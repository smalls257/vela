#!/usr/bin/env python3
"""vela: check and render an initiative vault. The format is in CONVENTIONS.md."""
import os
import pathlib
import sys

# 3.9 is what a Mac's /usr/bin/python3 ships, so a colleague needs nothing installed to run vela.
if sys.version_info < (3, 9):
    print("vela: needs Python 3.9 or later. On a Mac: brew install python@3.12", file=sys.stderr)
    sys.exit(2)


def cache_home():
    """The user's cache folder, never ~/.claude: $XDG_CACHE_HOME, else ~/Library/Caches on a Mac, %LOCALAPPDATA% on
    Windows, else ~/.cache."""
    given = os.environ.get("XDG_CACHE_HOME")
    if given:
        return pathlib.Path(given)
    if sys.platform == "darwin":
        return pathlib.Path.home() / "Library" / "Caches"
    if sys.platform == "win32":
        return pathlib.Path(os.environ.get("LOCALAPPDATA") or pathlib.Path.home() / "AppData" / "Local")
    return pathlib.Path.home() / ".cache"


# A vault is a git repo, and a vendored copy of the plugin can sit inside it: compiled caches written next to the
# plugin would end up committed. So bytecode is cached in the user's cache folder instead. Writing none at all made
# an installed plugin compile every module on every run (0.68 s CPU for `vela status` on a big vault, 0.45 s with a
# cache). A folder that can't be written just means no cache; Python already copes.
def plugin_version():
    """The installed plugin's version, "unversioned" when plugin.json can't be read. The release zips stamp every file
    1980-01-01, and Python trusts a .pyc by source mtime and size: a newer version unzipped over the same path with a
    constant changed to a same-length value would run the old bytecode. A cache folder per version cannot."""
    try:
        import json
        manifest = pathlib.Path(__file__).resolve().parent.parent / ".claude-plugin" / "plugin.json"
        return str(json.loads(manifest.read_text(encoding="utf-8")).get("version") or "unversioned")
    except (OSError, ValueError, AttributeError):
        return "unversioned"


sys.pycache_prefix = os.environ.get("VELA_PYCACHE") or str(cache_home() / "vela" / "pycache" / plugin_version())

# lib/ goes first on the path, so `import yaml` is always the vendored PyYAML in lib/yaml, never a copy
# installed on this machine: the same YAML behavior everywhere, and no pip step for whoever installs the plugin.
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

argv = sys.argv[1:]
from vela.commands import fast  # noqa: E402  (imports only the command registry and say)

if fast.serves(argv):
    sys.exit(fast.main(argv))

from vela.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
