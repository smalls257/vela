#!/usr/bin/env bash
# Runs the gate on exactly what is being pushed, in a throwaway worktree at that commit. The working tree
# can hold untracked files a test leans on (tests/sim/results is gitignored); a clean checkout cannot,
# so a push passes here only if it would pass in CI.
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per ref (git-scm.com/docs/githooks#_pre_push)
set -uo pipefail
zero=0000000000000000000000000000000000000000
mode="${GATE_MODE:-fast}"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # deleting a remote branch: nothing to check
  tree="$(mktemp -d "${TMPDIR:-/tmp}/gate.XXXXXX")"
  git worktree add --quiet --detach "$tree" "$local_sha" || exit 2
  echo "pre-push: $local_ref -> $remote_ref at ${local_sha:0:9} ($mode)"
  (cd "$tree" && .githooks/gate "$mode") || status=1
  git worktree remove --force "$tree"
done
if [ $status -ne 0 ]; then
  echo "pre-push: the gate failed, so nothing was pushed. Fix the stage named above; do not bypass with --no-verify." >&2
fi
exit $status
