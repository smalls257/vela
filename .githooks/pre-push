#!/usr/bin/env bash
# Runs the gate on exactly what is being pushed, in a throwaway worktree at that commit. The working tree
# can hold untracked files a test leans on (tests/sim/results is gitignored); a clean checkout cannot,
# so a push passes here only if it would pass in CI.
# The gate is about the code, so it runs once per distinct tree: two branches at the same tree are one run, and a
# tree that already passed in this mode is not run again. Passes are recorded in <git dir>/gate-passed, one
# "<tree> <mode>" line each, and every skip is printed with its reason. Delete that file to force a full re-run.
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per ref (git-scm.com/docs/githooks#_pre_push)
set -uo pipefail
zero=0000000000000000000000000000000000000000
# Static by default (rules, sync, vault checks; no pytest): the owner turned the long test runs off on 2026-10-21
# to save time. GATE_MODE=fast (or full) brings the tests back for one push.
mode="${GATE_MODE:-static}"
passed_file="$(git rev-parse --git-common-dir)/gate-passed"
touch "$passed_file"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # deleting a remote branch: nothing to check
  if [ "$remote_ref" = "refs/heads/gh-pages" ]; then
    # The published example site: built pages, no code, so no gate to run. Anyone with the link reads it,
    # so it is checked for leaks instead (tools/check_site.py), with the pusher's git email forbidden. The git name is
    # not: it is the GitHub handle that owns the public repo, so every install link on the site carries it.
    tree="$(mktemp -d "${TMPDIR:-/tmp}/gate.XXXXXX")"
    git worktree add --quiet --detach "$tree" "$local_sha" || exit 2
    echo "pre-push: $local_ref -> $remote_ref at ${local_sha:0:9} (site check)"
    python3 "$(git rev-parse --git-common-dir)/../tools/check_site.py" "$tree" \
      --forbid "$(git config user.email)" || status=1
    git worktree remove --force "$tree"
    continue
  fi
  if [ "$remote_ref" = "refs/heads/release" ]; then
    # The generated install branch (tools/build_release_branch.py): only the plugin, the manifest, LICENSE and a README.
    # It holds no code to gate, so it gets its own check: allowed paths, a parsing manifest, a version above the
    # previous release, and no oversized file.
    echo "pre-push: $local_ref -> $remote_ref at ${local_sha:0:9} (release check)"
    python3 "$(cd "$(dirname "$0")/.." && pwd)/tools/build_release_branch.py" --check "$local_sha" || status=1
    continue
  fi
  tree_id="$(git rev-parse "$local_sha^{tree}")"
  if grep -qx "$tree_id $mode" "$passed_file"; then
    echo "pre-push: $local_ref -> $remote_ref at ${local_sha:0:9}: this exact code (tree ${tree_id:0:9}) already passed the $mode gate; not run again"
    continue
  fi
  tree="$(mktemp -d "${TMPDIR:-/tmp}/gate.XXXXXX")"
  git worktree add --quiet --detach "$tree" "$local_sha" || exit 2
  echo "pre-push: $local_ref -> $remote_ref at ${local_sha:0:9} ($mode)"
  if (cd "$tree" && .githooks/gate "$mode"); then
    echo "$tree_id $mode" >> "$passed_file"
  else
    status=1
  fi
  git worktree remove --force "$tree"
done
if [ $status -ne 0 ]; then
  echo "pre-push: the gate failed, so nothing was pushed. Fix the stage named above; do not bypass with --no-verify." >&2
fi
exit $status
