{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gates.py\" after-edit",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gates.py\" guard-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gates.py\" before-stop",
            "timeout": 180
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gates.py\" before-stop",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gates.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Edit(/.githooks/**)",
      "Edit(/.semgrep/**)",
      "Edit(/.semgrepignore)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.quality/**)",
      "Edit(/ruff.toml)",
      "Edit(/tools/quality_*.py)",
      "Bash(python3 tools/quality_seed.py*)"
    ],
    "deny": [
      "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)",
      "Bash(git config --unset core.hooksPath*)"
    ]
  }
}
