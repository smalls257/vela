#!/bin/sh
# Stops a commit that carries the inbox, the private voice folders or the planner's own working files.
# The rules and their reasons live in the planner (plugin/lib/planner/guard.py); this hook only asks it, so the
# list is never copied here. `planner close stage` already refuses those paths: this catches a commit typed by hand.
# Turned on per clone with: git config core.hooksPath .githooks
# The planner is found at PLANNER (a path to its launcher) or at .claude/skills/planner/scripts/planner.
# If it cannot be found the commit is stopped, not waved through: a check that passes when it cannot run is no check.
# To commit anyway, on purpose: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 2
planner="${PLANNER:-$root/.claude/skills/planner/scripts/planner}"
if [ ! -f "$planner" ]; then
  echo "pre-commit: the planner is not at $planner, so the staged files were not checked." >&2
  echo "Install the plugin (README step 2) or set PLANNER to its launcher. To commit unchecked: git commit --no-verify" >&2
  exit 1
fi
exec python3 "$planner" guard staged --vault "$root"
