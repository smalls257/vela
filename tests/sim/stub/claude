#!/usr/bin/env python3
"""A scripted fake of `claude -p` for the simulator's free tests and `run.py --stub`. It never calls a model.

It answers as one of three roles, told apart by the system prompt run.py passes:
- assistant (no --system-prompt): stream-json events. The first turn of a session asks a question; a resumed
  turn says the session is over. It runs `gh pr create` so tests can see which gh is on PATH.
- persona ("SIMULATOR PERSONA"): JSON result. It replies "[END]" when the latest assistant message says the
  session is over, and otherwise a reply with a <script> tag in it, to test escaping.
- judge ("SIMULATOR JUDGE: <category>"): that category's verdicts, each with a grounds note. Across the categories
  there is one valid citation (U1) and two the driver must drop (W1's turn, K2's page). The probe's "options"
  judge gets one row per "LABEL: <label>" line in its input, with every part answered "not present". The
  "precision" judge classes P1 padding, P2 a duplicate of its first neighbour (padding when it has none), the last
  item backed by a lead turn that does not exist (the driver must drop it), and every other item backed as a question
  quoting its own first four words.

Knobs, all environment variables:
  SIM_STUB_COST   total_cost_usd of every assistant and persona call (default 0.01); the judge costs 0.01
  SIM_STUB_DROP   a field to leave out of the assistant's result event, such as total_cost_usd
  SIM_STUB_JUDGE  "bad" makes the judge reply with text that is not JSON; "nogrounds" leaves out every grounds note;
                  "refuse:<category>" makes that category's judge call stop with stop_reason refusal, every time
                  "toolong:<category>" makes that category's judge call fail as the real CLI does when the prompt is over
                  the window: is_error true, subtype "success", terminal_reason "prompt_too_long"
  SIM_STUB_LOG    a file to append one JSON line per call to: role, judge category, argv, cwd, the gh on PATH, the characters on stdin
  SIM_STUB_KILL_AT  "<n>": the n-th assistant call (counted in SIM_STUB_LOG, which it needs) kills the driver that called it
                  with SIGKILL before answering, as a crash or a closed laptop would, so --resume-run can be tested
  SIM_STUB_REPLY  a file whose text is the assistant's first turn of a session, instead of the default
  SIM_STUB_WRITE  "<path>::<text>": the assistant's first turn of a session appends <text> to <path> in its cwd; a JSON object
                  {"<path>": "<text>", ...} instead creates each file that does not exist yet, so a design is written once
"""
import json
import pathlib
import os
import re
import shutil
import signal
import subprocess
import sys
import uuid


def value_after(argv, flag):
    return argv[argv.index(flag) + 1] if flag in argv else None


def log(argv, role, category=None, stdin_chars=None):
    path = os.environ.get("SIM_STUB_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as out:
            out.write(json.dumps({"role": role, "category": category, "argv": argv, "cwd": os.getcwd(),
                                  "gh": shutil.which("gh"), "tmpdir": os.environ.get("TMPDIR"),
                                  "stdin_chars": stdin_chars}) + "\n")


def result(text, session_id, argv, cost=None):
    """A result event. Like the real CLI, a call whose cost would pass --max-budget-usd stops at the cap and
    reports error_max_budget_usd."""
    cost = float(os.environ.get("SIM_STUB_COST", "0.01")) if cost is None else cost
    cap = float(value_after(argv, "--max-budget-usd") or "inf")
    if cost > cap:
        return {"type": "result", "subtype": "error_max_budget_usd", "is_error": True, "session_id": session_id,
                "total_cost_usd": cap, "num_turns": 1, "errors": ["Reached maximum budget"]}
    return {"type": "result", "subtype": "success", "is_error": False, "result": text, "session_id": session_id,
            "total_cost_usd": cost, "num_turns": 1}


def stub_writes(setting):
    """{path: text} from SIM_STUB_WRITE: a JSON object, or the older "<path>::<text>"."""
    if setting.startswith("{"):
        return json.loads(setting)
    path, written = setting.split("::", 1)
    return {path: written}


def close_rebuilds_the_explorer(argv):
    """What the real close skill ends with: `vela explore` from the vault root, without --serve. The stub runs the
    plugin's own command so the page it leaves is the tool's, and says what the command said."""
    plugin = pathlib.Path(argv[argv.index("--plugin-dir") + 1])
    done = subprocess.run([sys.executable, str(plugin / "scripts" / "vela"), "explore"], capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        return f"The explorer could not be built: {(done.stdout + done.stderr).strip()}"
    return "The dashboard is up to date: dashboard.html"


def assistant(argv):
    prompt = argv[argv.index("--") + 1] if "--" in argv else ""
    resumed = value_after(argv, "--resume")
    session_id = resumed or f"stub-{uuid.uuid4().hex[:8]}"
    gh = subprocess.run(["gh", "pr", "create"], capture_output=True, text=True)
    with open("stub-note.txt", "a", encoding="utf-8") as out:
        out.write(prompt[:60] + "\n")
    if resumed:
        text = "Noted. That is all for now: the session is over."
    elif os.environ.get("SIM_STUB_REPLY"):
        with open(os.environ["SIM_STUB_REPLY"], encoding="utf-8") as reply:
            text = reply.read()
    else:
        text = f"Stub assistant heard: {prompt[:120]}\n\ngh said: {(gh.stdout + gh.stderr).strip()}\n\nWhat else is on your mind?"
    if not resumed and os.environ.get("SIM_STUB_WRITE"):
        once = os.environ["SIM_STUB_WRITE"].startswith("{")
        for path, written in stub_writes(os.environ["SIM_STUB_WRITE"]).items():
            if once and os.path.exists(path):
                continue
            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
            with open(path, "a", encoding="utf-8") as out:
                out.write(written + "\n")
    if not resumed and prompt.startswith("/vela:close"):
        text += "\n\n" + close_rebuilds_the_explorer(argv)
    # The plugin's own skills, read from the --plugin-dir it was given, as the CLI lists them: a hand-kept list fell
    # behind when requirements, allocate and releases were added, and a stub run then failed on them.
    plugin = pathlib.Path(argv[argv.index("--plugin-dir") + 1]) if "--plugin-dir" in argv else None
    commands = sorted(f"vela:{d.name}" for d in (plugin / "skills").iterdir() if (d / "SKILL.md").is_file()) if plugin else []
    skills = pathlib.Path.cwd() / ".claude" / "skills"
    commands += sorted(d.name for d in skills.iterdir() if (d / "SKILL.md").is_file()) if skills.is_dir() else []  # project skills, as the CLI lists them
    events = [{"type": "system", "subtype": "init", "session_id": session_id, "slash_commands": commands},
              {"type": "assistant", "message": {"content": [
                  {"type": "text", "text": text},
                  {"type": "tool_use", "id": "tu1", "name": "Bash", "input": {"command": "gh pr create"}}]}},
              result(text, session_id, argv)]
    drop = os.environ.get("SIM_STUB_DROP")
    if drop:
        events[-1].pop(drop, None)
    print("not json: a stray line the driver must skip")
    for event in events:
        print(json.dumps(event))


def persona(stdin, argv):
    latest = stdin.split("LATEST ASSISTANT MESSAGE:", 1)[-1]
    text = "[END]" if "session is over" in latest else "Yes. <script>alert('x')</script> Honestly not sure about the rest."
    print(json.dumps(result(text, "persona", argv)))


def judge(stdin, argv, category):
    """One category's verdicts, each with its grounds note first, as run.py demands."""
    mode = os.environ.get("SIM_STUB_JUDGE")
    if mode == f"refuse:{category}":
        text = "API Error: the safeguards flagged this message.\n\nDetails: `[reasoning_extraction]`"
        refusal = result(text, "judge", argv, cost=0.01)
        print(json.dumps({**refusal, "stop_reason": "refusal"}))
        return
    if mode == f"toolong:{category}":
        print(json.dumps({"type": "result", "subtype": "success", "is_error": True, "terminal_reason": "prompt_too_long",
                          "api_error_status": 400, "session_id": "judge", "total_cost_usd": 0, "num_turns": 1,
                          "result": "Prompt is too long: the request is ~341431 tokens (limit 200000)."}))
        return
    if mode == "bad":
        print(json.dumps(result("I think the vela arm did well.", "judge", argv, cost=0.01)))
        return
    note = {} if mode == "nogrounds" else {"grounds": f"stub: read the {category} hints and the turns they name"}
    if category == "options":
        absent = {"present": False, "quote": None}
        rows = [{"label": label.strip(), "search": "stub: read the option", "label_quote": None, "costs": absent,
                 "rules_out": absent, "stakeholder_or_unknown": absent}
                for label in re.findall(r"^LABEL: (.+)$", stdin, re.M)]
        print(json.dumps(result(json.dumps({"search": "stub: read the turn", "options": rows}), "judge", argv, cost=0.01)))
        return
    if category == "precision":
        print(json.dumps(result(json.dumps({"items": precision_rows(stdin, note)}), "judge", argv, cost=0.01)))
        return
    if category == "tracer":
        line = re.search(r"^- \*\*Tracer:\*\*.*$", stdin, re.M)
        if not line:
            print(json.dumps(result(json.dumps({**note, "answer": "not_recorded"}), "judge", argv, cost=0.01)))
            return
        page = re.findall(r"^----- FILE (\S+) -----$", stdin[:line.start()], re.M)[-1]
        card = {**note, "answer": "tracer", "through_every_app": True, "where": page, "quote": line.group(0).lstrip("- ")}
        print(json.dumps(result(json.dumps(card), "judge", argv, cost=0.01)))
        return
    if category == "shape":
        sessions = [int(s) for s in re.search(r"^SESSIONS THAT RAN: (.*)$", stdin, re.M).group(1).split(",") if s.strip()]
        card = {**note, "decided_without_yes": [], "told_not_asked": [], "invented_facts": [],
                "session_endings": [{"session": s, "clear_next_step": False, "turn": None, "quote": None} for s in sessions]}
        print(json.dumps(result(json.dumps(card), "judge", argv, cost=0.01)))
        return
    ids = [i.strip() for i in re.search(rf"^IDS {category}: ?(.*)$", stdin, re.M).group(1).split(",") if i.strip()]
    flag = {"unaware": "surfaced", "wrong": "challenged", "knows": "captured", "decisions": "decided",
            "conflicts": "surfaced"}[category]
    if category == "knows":
        rows = [{"id": i, **note, flag: False, "where": None} for i in ids]
    else:
        rows = [{"id": i, **note, flag: False, "turn": None, "quote": None} for i in ids]
        if category == "decisions":
            for row in rows:
                row["yes_asked"] = False
    first = re.search(r"^\[T(\d+)\] ASSISTANT:\n(.+)$", stdin, re.M)
    if category == "unaware" and first and rows:
        rows[0].update(surfaced=True, turn=int(first.group(1)), quote=" ".join(first.group(2).split()[:4]))
    if category == "wrong" and rows:
        rows[0].update(challenged=True, turn=999, quote="a quote no turn holds")
    if category == "knows" and len(rows) >= 2:
        rows[0].update(captured=True, where="01-goals.md")
        rows[1].update(captured=True, where="no-such-page.md")
    print(json.dumps(result(json.dumps({category: rows}), "judge", argv, cost=0.01)))


def precision_rows(stdin, note):
    ids = [i.strip() for i in re.search(r"^IDS precision: ?(.*)$", stdin, re.M).group(1).split(",") if i.strip()]
    rows = []
    for n, label in enumerate(ids):
        item = re.search(rf"^----- ITEM {re.escape(label)} \(.*?\) -----\n(.*?)\nOTHER ITEMS NEAR IT:\n(.*?)(?:\n\n|\Z)",
                         stdin, re.M | re.S)
        text, near = (item.group(1), item.group(2)) if item else ("", "")
        first = re.search(rf"^  ({re.escape(label)}\.N1) ", near, re.M)
        row = {"id": label, **note, "class": "backed", "basis": "question", "turn": None, "where": None,
               "quote": " ".join(text.split()[:4]), "duplicate_of": None}
        if n == 0:
            row.update({"class": "padding", "basis": None, "quote": None})
        elif n == 1:
            row.update({"class": "duplicate", "basis": None, "duplicate_of": first.group(1)} if first else
                       {"class": "padding", "basis": None, "quote": None})
        elif n == len(ids) - 1:
            row.update(basis="lead", turn=999, quote="a quote no turn holds")
        rows.append(row)
    return rows


def kill_driver_on_cue():
    """SIM_STUB_KILL_AT: the driver dies mid-run, with nothing flushed and no summary written."""
    at = os.environ.get("SIM_STUB_KILL_AT")
    if not at:
        return
    with open(os.environ["SIM_STUB_LOG"], encoding="utf-8") as calls:
        made = sum(1 for line in calls if json.loads(line)["role"] == "assistant")
    if made == int(at):
        os.kill(os.getppid(), signal.SIGKILL)
        sys.exit(1)


def main():
    argv = sys.argv[1:]
    system = value_after(argv, "--system-prompt") or ""
    role = "judge" if system.startswith("SIMULATOR JUDGE") else "persona" if system.startswith("SIMULATOR PERSONA") else "assistant"
    category = re.match(r"SIMULATOR JUDGE: (\w+)", system).group(1) if role == "judge" else None
    stdin = sys.stdin.read() if role != "assistant" else None
    log(argv, role, category, None if stdin is None else len(stdin))
    if role == "assistant":
        kill_driver_on_cue()
        assistant(argv)
    else:
        persona(stdin, argv) if role == "persona" else judge(stdin, argv, category)


if __name__ == "__main__":
    main()
